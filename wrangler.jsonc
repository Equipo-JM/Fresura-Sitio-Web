{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fresura-sitio-web",
	"compatibility_date": "2026-10-27",
	// Solo archivos estáticos: no hay Worker propio (DT-01, F24).
	// "single-page-application" hace que rutas como /privacidad sirvan index.html.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
